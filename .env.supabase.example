# Supabase account settings > Access Tokens. Keep this private.
SUPABASE_ACCESS_TOKEN=

# The project ref appears in https://supabase.com/dashboard/project/<project-ref>.
SUPABASE_PROJECT_REF=

# These values let the deployer's pre-deployment project check build the site.
PUBLIC_SITE_URL=https://example.com
PUBLIC_SITE_NAME=Astro Simple Blog
PUBLIC_SITE_AUTHOR=Site Author
PUBLIC_SITE_DESCRIPTION=A multilingual Astro blog for notes, guides, and articles.
PUBLIC_CONTACT_EMAIL=contact@example.com
