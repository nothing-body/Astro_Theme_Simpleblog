# 1) Copy this file to .env.vps.
# 2) Fill in real VPS deploy values.
# 3) Keep .env.vps private (already ignored by .gitignore).

VPS_HOST=203.0.113.10
VPS_USER=deploy
VPS_PORT=22
VPS_SSH_KEY_PATH=~/.ssh/id_rsa

# Optional. Prefer ssh-agent when possible.
# If your private key is encrypted and you cannot use ssh-agent, set this locally or in CI secrets.
# Do not commit the real passphrase.
VPS_SSH_PASSPHRASE=

# Recommended for CI and production: pin the server host key.
VPS_KNOWN_HOSTS_FILE=~/.ssh/known_hosts

VPS_TARGET_DIR=/var/www/example.com

PUBLIC_SITE_URL=https://example.com
PUBLIC_SITE_NAME=Astro Simple Blog
PUBLIC_SITE_AUTHOR=Site Author
PUBLIC_SITE_DESCRIPTION=A multilingual Astro blog for notes, guides, and articles.
PUBLIC_CONTACT_EMAIL=contact@example.com
