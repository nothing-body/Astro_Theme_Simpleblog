{
  "name": "astro-theme-simpleblog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "devalue": ">=5.8.1",
      "esbuild": "0.28.1",
      "@babel/core@<=7.29.0": "7.29.6",
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "@tootallnate/once@<2.0.1": "2.0.1",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "tar@<7.5.16": "7.5.16",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "smol-toml@<1.7.1": "1.7.1",
      "undici@>=4.5.0 <6.28.0": "6.28.0",
      "image-size@>=2.0.0 <2.0.4": "2.0.4"
    }
  },
  "overrides": {
    "devalue": ">=5.8.1",
    "esbuild": "0.28.1",
    "@babel/core@<=7.29.0": "7.29.6",
    "@opentelemetry/core@<2.8.0": "2.8.0",
    "@tootallnate/once@<2.0.1": "2.0.1",
    "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
    "minimatch@>=10.0.0 <10.2.3": "10.2.3",
    "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
    "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
    "tar@<7.5.16": "7.5.16",
    "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "smol-toml@<1.7.1": "1.7.1",
    "undici@>=4.5.0 <6.28.0": "6.28.0",
    "image-size@>=2.0.0 <2.0.4": "2.0.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsx ./scripts/clean-generated.ts && astro build && pagefind --site dist --glob \"**/index.html\" && tsx ./scripts/finalize-search.ts && tsx ./scripts/check-output.ts",
    "check": "tsx ./scripts/run-sequence.ts check:types lint lint:css check:deps test:unit",
    "check:types": "astro check && tsc --noEmit",
    "check:base": "tsx ./scripts/run-sequence.ts check:types lint lint:css check:deps test:unit",
    "check:deps": "knip --no-progress --exclude exports,types",
    "preview": "astro preview",
    "astro": "astro",
    "deploy:switch": "tsx ./scripts/deploy_switch.ts",
    "deploy:cf:only": "tsx ./scripts/uploaddist_cf.ts",
    "deploy:vps:only": "tsx ./scripts/uploaddist_vps.ts",
    "deploy:vps-docker:only": "tsx ./scripts/uploaddist_vps_docker.ts",
    "deploy:vercel:only": "tsx ./scripts/uploaddist_vercel.ts",
    "deploy:netlify:only": "tsx ./scripts/uploaddist_netlify.ts",
    "deploy:supabase:only": "tsx ./scripts/uploaddist_supabase.ts",
    "deploy:cf:vps": "tsx ./scripts/deploy_switch.ts --mode=direct:cf+vps",
    "deploy:cf:vercel": "tsx ./scripts/deploy_switch.ts --mode=direct:cf+vercel",
    "deploy:vps:vercel": "tsx ./scripts/deploy_switch.ts --mode=direct:vps+vercel",
    "deploy:all": "tsx ./scripts/deploy_switch.ts --mode=direct:cf+vps+vercel",
    "deploy:all:static": "tsx ./scripts/deploy_switch.ts --mode=direct:cf+vps+vps-docker+vercel+netlify",
    "deploy:all:including-functions": "tsx ./scripts/deploy_switch.ts --mode=direct:cf+vps+vps-docker+vercel+netlify+supabase",
    "uploaddist:cf:node": "tsx ./scripts/uploaddist_cf.ts",
    "uploaddist:vps:node": "tsx ./scripts/uploaddist_vps.ts",
    "uploaddist:vps-docker:node": "tsx ./scripts/uploaddist_vps_docker.ts",
    "uploaddist:vercel:node": "tsx ./scripts/uploaddist_vercel.ts",
    "uploaddist:netlify:node": "tsx ./scripts/uploaddist_netlify.ts",
    "uploaddist:supabase:node": "tsx ./scripts/uploaddist_supabase.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\" && stylelint \"src/**/*.astro\" --custom-syntax postcss-html",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix && stylelint \"src/**/*.astro\" --custom-syntax postcss-html --fix",
    "audit:security": "tsx ./scripts/audit-security.ts",
    "format": "prettier --write \"src/**/*.{ts,astro,css,md}\" \"scripts/**/*.ts\" \"*.ts\"",
    "test": "tsx ./scripts/run-sequence.ts test:unit build test:e2e",
    "test:unit": "jest --runInBand",
    "test:e2e": "tsx ./scripts/run-e2e.ts",
    "analyze": "tsx ./scripts/analysis.ts",
    "selfcheck": "tsx ./scripts/analysis.ts",
    "deploy:menu": "tsx ./scripts/deploy_menu.ts",
    "upgrade:astro": "tsx ./scripts/upgrade_astro.ts",
    "lighthouse": "tsx ./run-lh.ts",
    "check:output": "tsx ./scripts/check-output.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/partytown": "2.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.3.3",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.4",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "astro-eslint-parser": "^3.1.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-security": "^4.0.1",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "image-size": "2.0.4",
    "jest": "^30.5.1",
    "knip": "^6.37.0",
    "lighthouse": "^13.4.1",
    "pagefind": "1.5.2",
    "playwright": "^1.63.0",
    "postcss-html": "2.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "supabase": "2.117.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "vite": "8.3.0",
    "wrangler": "^4.134.0",
    "yaml": "2.9.1"
  }
}
