# Copy to .env.vps-docker and keep the real file private.
VPS_HOST=203.0.113.10
VPS_USER=deploy
VPS_PORT=22
VPS_SSH_KEY_PATH=~/.ssh/id_ed25519
VPS_SSH_PASSPHRASE=
VPS_KNOWN_HOSTS_FILE=~/.ssh/known_hosts

# Remote directory that stores compose.yaml, Dockerfile, and the built site.
VPS_DOCKER_APP_DIR=/opt/astro-simpleblog
VPS_DOCKER_PROJECT_NAME=astro-simpleblog

# Bind to loopback and place an HTTPS reverse proxy in front of this port.
VPS_DOCKER_BIND_ADDRESS=127.0.0.1
VPS_DOCKER_HTTP_PORT=8080

# Set to 1 only after configuring the VPS firewall when binding to 0.0.0.0.
VPS_DOCKER_ALLOW_PUBLIC_BIND=0

PUBLIC_SITE_URL=https://example.com
PUBLIC_SITE_NAME=Astro Simple Blog
PUBLIC_SITE_AUTHOR=Site Author
PUBLIC_SITE_DESCRIPTION=A multilingual Astro blog for notes, guides, and articles.
PUBLIC_CONTACT_EMAIL=contact@example.com
