---
import { formatTranslation, useTranslations } from '../i18n/utils';

interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl?: string | undefined;
  nextUrl?: string | undefined;
  getPageUrl: (pageNumber: number) => string;
  lang?: 'zh-tw' | 'en' | 'zh-cn' | undefined;
}

const { currentPage, totalPages, prevUrl, nextUrl, getPageUrl, lang = 'zh-tw' } = Astro.props;
const t = useTranslations(lang);
const prevLabel = `← ${t('pagination.prev')}`;
const nextLabel = `${t('pagination.next')} →`;

function getAriaLabel(page: number): string {
  return formatTranslation(t('a11y.pageNumber'), { page });
}

function getPageNums(current: number, total: number): (number | null)[] {
  if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
  if (current <= 4) return [1, 2, 3, 4, 5, null, total];
  if (current >= total - 3) {
    return [1, null, total - 4, total - 3, total - 2, total - 1, total];
  }
  return [1, null, current - 1, current, current + 1, null, total];
}

const pageNums = getPageNums(currentPage, totalPages);
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label={t('a11y.pagination')}>
      {prevUrl ? (
        <a href={prevUrl} class="page-btn page-btn--nav" rel="prev" aria-label={prevLabel}>
          <span class="nav-text-full">{prevLabel}</span>
          <span class="nav-text-short">←</span>
        </a>
      ) : (
        <span
          class="page-btn page-btn--nav page-btn--disabled"
          aria-disabled="true"
          aria-label={prevLabel}
        >
          <span class="nav-text-full">{prevLabel}</span>
          <span class="nav-text-short">←</span>
        </span>
      )}

      <div class="page-numbers" role="list">
        {pageNums.map(page =>
          page === null ? (
            <span class="page-ellipsis" aria-hidden="true">…</span>
          ) : (
            <a
              href={getPageUrl(page)}
              class:list={['page-btn', { 'page-btn--active': page === currentPage }]}
              aria-label={getAriaLabel(page)}
              aria-current={page === currentPage ? 'page' : undefined}
              role="listitem"
            >
              {page}
            </a>
          )
        )}
      </div>

      {nextUrl ? (
        <a href={nextUrl} class="page-btn page-btn--nav" rel="next" aria-label={nextLabel}>
          <span class="nav-text-full">{nextLabel}</span>
          <span class="nav-text-short">→</span>
        </a>
      ) : (
        <span
          class="page-btn page-btn--nav page-btn--disabled"
          aria-disabled="true"
          aria-label={nextLabel}
        >
          <span class="nav-text-full">{nextLabel}</span>
          <span class="nav-text-short">→</span>
        </span>
      )}
    </nav>
  )
}
