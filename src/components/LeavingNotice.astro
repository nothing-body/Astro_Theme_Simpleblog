---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  en: {
    pageTitle: 'External Link Notice',
    pageDescription: 'A notice shown before leaving this site for an external website.',
    kicker: 'External link',
    title: 'You are leaving this site',
    body: 'The destination is outside this site. This page does not scan or verify it, so confirm the address before continuing.',
    destination: 'Destination',
    reading: 'Reading destination...',
    invalid: 'Invalid or missing destination',
    warning:
      'The destination could not be read safely. Return to the site and check the original link.',
    back: 'Back to site',
    continue: 'Continue',
    noScript: 'JavaScript is required to read the destination stored in this page URL.',
    backHref: '/',
  },
  'zh-tw': {
    pageTitle: '外部連結提示',
    pageDescription: '離開本站前顯示的外部網站提示。',
    kicker: '外部連結',
    title: '你即將離開本站',
    body: '目的地位於本站之外。此頁不會掃描或驗證該網站，繼續前請自行確認網址是否正確。',
    destination: '目的地',
    reading: '正在讀取目的地...',
    invalid: '目的地無效或遺失',
    warning: '無法安全讀取目的地，請返回本站並檢查原始連結。',
    back: '返回本站',
    continue: '繼續前往',
    noScript: '需要 JavaScript 才能讀取儲存在此頁網址中的目的地。',
    backHref: '/zh-tw',
  },
  'zh-cn': {
    pageTitle: '外部链接提示',
    pageDescription: '离开本站前显示的外部网站提示。',
    kicker: '外部链接',
    title: '你即将离开本站',
    body: '目标位于本站之外。此页面不会扫描或验证该网站，继续前请自行确认网址是否正确。',
    destination: '目标地址',
    reading: '正在读取目标地址...',
    invalid: '目标地址无效或缺失',
    warning: '无法安全读取目标地址，请返回本站并检查原始链接。',
    back: '返回本站',
    continue: '继续前往',
    noScript: '需要 JavaScript 才能读取保存在此页面网址中的目标地址。',
    backHref: '/zh-cn',
  },
}[lang];
---

<BaseLayout
  title={copy.pageTitle}
  description={copy.pageDescription}
  robots="noindex, nofollow"
  alternates={false}
  preserveLanguageFragment={true}
>
  <section
    class="leaving-page"
    aria-labelledby="leaving-title"
    data-leaving-notice
    data-invalid-text={copy.invalid}
    data-back-href={copy.backHref}
  >
    <div class="leaving-panel">
      <p class="leaving-kicker">{copy.kicker}</p>
      <h1 id="leaving-title">{copy.title}</h1>
      <p class="leaving-copy">{copy.body}</p>

      <div class="leaving-target" aria-live="polite">
        <span class="leaving-label">{copy.destination}</span>
        <strong id="leaving-host">{copy.reading}</strong>
        <code id="leaving-url"></code>
      </div>

      <p class="leaving-warning" id="leaving-warning" hidden>{copy.warning}</p>

      <div class="leaving-actions">
        <a class="leaving-button leaving-button-secondary" href={copy.backHref}>{copy.back}</a>
        <a
          class="leaving-button leaving-button-primary"
          id="leaving-continue"
          href={copy.backHref}
          rel="noopener noreferrer"
          aria-disabled="true"
        >
          {copy.continue}
        </a>
      </div>

      <noscript>
        <p class="leaving-warning">{copy.noScript}</p>
      </noscript>
    </div>
  </section>

  <script>
    import '../scripts/leaving-notice';
  </script>
</BaseLayout>

<style>
  .leaving-page {
    display: grid;
    min-height: min(720px, calc(100vh - 180px));
    place-items: center;
    padding: 3rem 1rem 4rem;
  }

  .leaving-panel {
    width: min(100%, 680px);
    padding: clamp(1.25rem, 4vw, 2.25rem);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-card);
    box-shadow: var(--shadow-md);
  }

  .leaving-kicker {
    margin: 0 0 0.6rem;
    color: var(--primary-red);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .leaving-panel h1 {
    margin: 0;
    color: var(--text-heading);
    font-size: 2.25rem;
    line-height: 1.15;
  }

  .leaving-copy {
    margin: 1rem 0 1.5rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .leaving-target {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-main);
  }

  .leaving-label {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .leaving-target strong,
  .leaving-target code {
    overflow-wrap: anywhere;
  }

  .leaving-target strong {
    color: var(--text-heading);
    font-size: 1.08rem;
  }

  .leaving-target code {
    color: var(--text-muted);
    font-size: 0.86rem;
    white-space: normal;
  }

  .leaving-warning {
    margin: 1rem 0 0;
    color: var(--primary-red-dark);
    font-weight: 700;
    line-height: 1.6;
  }

  .leaving-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .leaving-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0.72rem 1rem;
    border-radius: 8px;
    font-weight: 800;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .leaving-button-primary {
    border: 1px solid var(--primary-red);
    background: var(--primary-red);
    color: white;
  }

  .leaving-button-secondary {
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-heading);
  }

  .leaving-button[aria-disabled='true'] {
    pointer-events: none;
    opacity: 0.55;
  }

  .leaving-button-primary:hover {
    border-color: var(--primary-red-dark);
    background: var(--primary-red-dark);
  }

  .leaving-button-secondary:hover {
    border-color: var(--primary-red);
    color: var(--primary-red);
  }

  @media (max-width: 520px) {
    .leaving-panel h1 {
      font-size: 1.8rem;
    }

    .leaving-actions {
      flex-direction: column-reverse;
    }

    .leaving-button {
      width: 100%;
    }
  }
</style>
