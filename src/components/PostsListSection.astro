---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { BlogPost } from '../lib/posts';
import { paginatePosts } from '../lib/posts';
import { getPostsListUrl } from '../lib/routes';
import Pagination from './Pagination.astro';
import PostCard from './PostCard.astro';
import Sidebar from './Sidebar.astro';

export interface Props {
  lang: Lang;
  allPosts: BlogPost[];
  currentPage: number;
  totalPages: number;
}

const { lang, allPosts, currentPage, totalPages } = Astro.props;
const t = useTranslations(lang);
const posts = paginatePosts(allPosts, currentPage);
const getPageUrl = (pageNumber: number) => getPostsListUrl(lang, pageNumber);
const prevUrl = currentPage > 1 ? getPageUrl(currentPage - 1) : undefined;
const nextUrl = currentPage < totalPages ? getPageUrl(currentPage + 1) : undefined;
---

<div class="page-container posts-page-container">
  <div class="content-wrapper">
    <Sidebar allPosts={allPosts} lang={lang} />
    <div class="main-content">
      <h1 class="posts-page-title">{t('posts.title')}</h1>
      {
        posts.length > 0 ? (
          <>
            {posts.map(post => (
              <PostCard post={post} lang={lang} />
            ))}
            <Pagination
              currentPage={currentPage}
              totalPages={totalPages}
              prevUrl={prevUrl}
              nextUrl={nextUrl}
              getPageUrl={getPageUrl}
              lang={lang}
            />
          </>
        ) : (
          <p class="posts-no-posts">{t('posts.noPost')}</p>
        )
      }
    </div>
  </div>
</div>

<script is:inline src="/scripts/bb-last-list.js" defer></script>

<style>
  .posts-page-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .posts-page-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-heading);
    margin-bottom: 1.5rem;
  }

  .posts-no-posts {
    color: var(--text-muted);
    padding: 3rem 0;
    text-align: center;
  }
</style>
