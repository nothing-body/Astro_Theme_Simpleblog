---
import { defaultLang, type Lang } from '../i18n/ui';
import type { LanguageRoute } from '../types';
import {
  DEFAULT_AUTHOR,
  DEFAULT_DESCRIPTION,
  SITE_NAME,
  getSiteUrl,
} from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  canonicalUrl?: string;
  ogImage?: string;
  pubDate?: Date;
  updatedDate?: Date;
  type?: 'website' | 'article';
  tags?: string[];
  category?: string;
  author?: string;
  ga4Id?: string;
  robots?: string;
  alternates?: boolean;
  languageRoutes: Record<Lang, LanguageRoute>;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  lang = defaultLang,
  canonicalUrl,
  ogImage,
  pubDate,
  updatedDate,
  type = 'website',
  tags = [],
  category,
  author = DEFAULT_AUTHOR,
  ga4Id,
  robots,
  alternates = true,
  languageRoutes,
} = Astro.props;

const siteUrl = getSiteUrl(Astro.site);
const normalizedPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const currentUrl = canonicalUrl ?? new URL(normalizedPath, siteUrl).href;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).href : undefined;
const isDuplicateEnRoute = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const alternateLinks = (Object.entries(languageRoutes) as [Lang, LanguageRoute][])
  .filter(([, item]) => item.available)
  .map(([code, item]) => ({
    hreflang: code === 'zh-tw' ? 'zh-TW' : code === 'zh-cn' ? 'zh-CN' : 'en',
    href: new URL(item.canonicalPath, siteUrl).href,
  }));
const enUrl = alternateLinks.find(item => item.hreflang === 'en')?.href;
const safeGa4Id =
  typeof ga4Id === 'string' && /^G-[A-Z0-9]+$/i.test(ga4Id) && !ga4Id.startsWith('G-XXXX')
    ? ga4Id
    : '';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{
  robots ? (
    <meta name="robots" content={robots} />
  ) : (
    isDuplicateEnRoute && <meta name="robots" content="noindex, follow" />
  )
}
<link rel="canonical" href={currentUrl} />

{
  alternates && (
    <>
      {alternateLinks.map(item => (
        <link rel="alternate" hreflang={item.hreflang} href={item.href} />
      ))}
      {enUrl && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    </>
  )
}

<meta property="og:type" content={type} />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{
  ogImageUrl && (
    <>
      <meta property="og:image" content={ogImageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )
}
<meta property="og:site_name" content={SITE_NAME} />
<meta
  property="og:locale"
  content={lang === 'en' ? 'en_US' : lang === 'zh-cn' ? 'zh_CN' : 'zh_TW'}
/>

<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

{
  type === 'article' && pubDate && (
    <>
      <meta property="article:published_time" content={pubDate.toISOString()} />
      {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
      {author && <meta property="article:author" content={author} />}
      {category && <meta property="article:section" content={category} />}
      {tags.map((tag: string) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="referrer" content="strict-origin-when-cross-origin" />
<script is:inline src="/scripts/bb-settings-bootstrap.js"></script>
{safeGa4Id && <script is:inline src="/scripts/bb-ga4.js" data-ga4-id={safeGa4Id} defer />}
