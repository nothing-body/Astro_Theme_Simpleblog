---

import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh-cn');
---

<BaseLayout title={t('noCategory.title')} robots="noindex, follow" alternates={false}>
  <div class="page-container no-category-page" data-no-category data-redirect="/zh-cn/posts">
    <div>
      <div class="glass-card no-category-card">
        <p class="no-category-symbol" aria-hidden="true">404</p>
        <h1 class="no-category-title">
          {t('noCategory.title')}
        </h1>
        <p class="no-category-message">{t('noCategory.message')}</p>
        <p
          class="no-category-redirect"
          id="redirect-msg"
        >
          {t('noCategory.redirecting')}
        </p>
        <a href="/zh-cn/posts" class="btn-primary">{t('noCategory.manual')}</a>
      </div>
    </div>
  </div>

  <script>
    import '../../scripts/no-category';
  </script>
</BaseLayout>
