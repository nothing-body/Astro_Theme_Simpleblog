---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutSidebar from '../../components/AboutSidebar.astro';
import { SITE_NAME, getCanonicalUrl } from '../../lib/site';
import { safeJsonStringify } from '../../lib/utils';

const currentPath = Astro.url.pathname;
const pageUrl = getCanonicalUrl(currentPath, Astro.site);
const description = `关于 ${SITE_NAME} Astro 多语言静态博客模板。`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '关于本站',
  url: pageUrl,
  description,
  publisher: { '@type': 'Organization', name: SITE_NAME },
};
---

<BaseLayout title="关于本站" {description}>
  <script is:inline type="application/ld+json" set:html={safeJsonStringify(jsonLd)} />
  <div class="page-container" style="padding-top: 2rem; padding-bottom: 4rem;">
    <div class="content-wrapper">
      <AboutSidebar lang="zh-cn" currentPath={currentPath} />
      <div class="main-content">
        <article class="glass-card be-article-wrapper" style="padding: 2.5rem;">
          <div class="article-entry">
            <h1>关于本站</h1>
            <p>
              {SITE_NAME} 是一套 Astro 多语言静态博客模板，支持 Markdown/MDX、分类、标签、SEO、隐私设置与部署工具。
            </p>
            <h2>定制这个页面</h2>
            <p>
              请将本段替换为你愿意公开的介绍。在 <code>src/lib/site.ts</code> 修改网站名称与作者，并同步检查英文和繁体中文页面。
            </p>
            <h2>安全发布</h2>
            <p>
              公开仓库不可包含真实环境文件、token、私钥、私人文章与个人图片。部署前请运行 <code>pnpm selfcheck</code>。
            </p>
          </div>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>
