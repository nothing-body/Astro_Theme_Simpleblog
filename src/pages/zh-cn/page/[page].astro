---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostsListSection from '../../../components/PostsListSection.astro';
import { useTranslations } from '../../../i18n/utils';
import { getPostsPageStaticPaths } from '../../../lib/posts';

export async function getStaticPaths() {
  return getPostsPageStaticPaths('zh-cn');
}

const { page } = Astro.params;
const { totalPages, allPosts } = Astro.props;
const t = useTranslations('zh-cn');
const currentPage = Number(page);
---

<BaseLayout
  title={`${t('posts.title')} - 第 ${currentPage} 页`}
  description={`所有文章列表第 ${currentPage} 页。`}
>
  <PostsListSection
    lang="zh-cn"
    allPosts={allPosts}
    currentPage={currentPage}
    totalPages={totalPages}
  />
</BaseLayout>
