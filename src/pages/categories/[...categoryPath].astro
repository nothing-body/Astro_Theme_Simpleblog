---
import ArchivePage from '../../components/ArchivePage.astro';
import { getCategoryArchiveStaticPaths } from '../../lib/archive-paths';
import { parseCategoryRoutePath } from '../../lib/categories';

export const getStaticPaths = () => getCategoryArchiveStaticPaths('en');

const { allPosts, categoryPosts, currentCategoryPath, totalPages } = Astro.props;
const { page: currentPage } = parseCategoryRoutePath(Astro.params.categoryPath);
---

<ArchivePage
  kind="category"
  lang="en"
  allPosts={allPosts}
  filteredPosts={categoryPosts}
  label={currentCategoryPath.join(' / ')}
  categoryPath={currentCategoryPath}
  currentPage={currentPage}
  totalPages={totalPages}
/>
