---
import PostsPage from '../../components/PostsPage.astro';
import { getPublishedPostsForLang, getTotalPages } from '../../lib/posts';

const allPosts = await getPublishedPostsForLang('zh-tw');
---

<PostsPage
  lang="zh-tw"
  allPosts={allPosts}
  currentPage={1}
  totalPages={getTotalPages(allPosts.length)}
/>
