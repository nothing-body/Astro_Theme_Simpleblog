---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutSidebar from '../../components/AboutSidebar.astro';
import { SITE_NAME, getCanonicalUrl } from '../../lib/site';
import { safeJsonStringify } from '../../lib/utils';

const currentPath = Astro.url.pathname;
const pageUrl = getCanonicalUrl(currentPath, Astro.site);
const description = `關於 ${SITE_NAME} Astro 多語系靜態部落格模板。`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '關於本站',
  url: pageUrl,
  description,
  publisher: { '@type': 'Organization', name: SITE_NAME },
};
---

<BaseLayout title="關於本站" {description}>
  <script is:inline type="application/ld+json" set:html={safeJsonStringify(jsonLd)} />
  <div class="page-container content-page">
    <div class="content-wrapper">
      <AboutSidebar lang="zh-tw" currentPath={currentPath} />
      <div class="main-content">
        <article class="glass-card be-article-wrapper content-article">
          <div class="article-entry">
            <h1>關於本站</h1>
            <p>
              {SITE_NAME} 是一套 Astro 多語系靜態部落格模板，支援 Markdown、分類、標籤、SEO、隱私設定與部署工具。
            </p>
            <h2>客製這個頁面</h2>
            <p>
              請將本段替換成你願意公開的介紹。在 <code>src/lib/site.ts</code> 修改網站名稱與作者，並同步檢查英文與簡體中文頁面。
            </p>
            <h2>安全發布</h2>
            <p>
              公開倉庫不可包含真實環境檔、token、私鑰、私人文章與個人圖片。部署前請執行 <code>pnpm selfcheck</code>。
            </p>
          </div>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>
