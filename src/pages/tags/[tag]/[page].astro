---
import ArchivePage from '../../../components/ArchivePage.astro';
import { getTagArchiveStaticPaths } from '../../../lib/archive-paths';

export const getStaticPaths = () => getTagArchiveStaticPaths('en');

const { allPosts, tagPosts, currentTag, totalPages } = Astro.props;
const currentPage = Number(Astro.params.page);
---

<ArchivePage
  kind="tag"
  lang="en"
  allPosts={allPosts}
  filteredPosts={tagPosts}
  label={currentTag}
  currentPage={currentPage}
  totalPages={totalPages}
/>
