---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSidebar from '../components/AboutSidebar.astro';
import { SITE_NAME, getCanonicalUrl } from '../lib/site';
import { safeJsonStringify } from '../lib/utils';

const currentPath = Astro.url.pathname;
const pageUrl = getCanonicalUrl(currentPath, Astro.site);
const description = `About ${SITE_NAME}, a multilingual Astro static blog template.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'About This Site',
  url: pageUrl,
  description,
  publisher: { '@type': 'Organization', name: SITE_NAME },
};
---

<BaseLayout title="About This Site" {description}>
  <script is:inline type="application/ld+json" set:html={safeJsonStringify(jsonLd)} />
  <div class="page-container content-page">
    <div class="content-wrapper">
      <AboutSidebar lang="en" currentPath={currentPath} />
      <div class="main-content">
        <article class="glass-card be-article-wrapper content-article">
          <div class="article-entry">
            <h1>About This Site</h1>
            <p>
              {SITE_NAME} is a multilingual Astro static blog template with Markdown content,
              categories, tags, SEO metadata, privacy controls, and deployment helpers.
            </p>
            <h2>Customize this page</h2>
            <p>
              Replace this text with information you intend to publish. Update the site name and author
              in <code>src/lib/site.ts</code>, then review the matching pages under
              <code>src/pages/zh-tw/</code> and <code>src/pages/zh-cn/</code>.
            </p>
            <h2>Publishing safely</h2>
            <p>
              Keep real environment files, tokens, private keys, private posts, and personal images out
              of public repositories. Run <code>pnpm selfcheck</code> before deployment.
            </p>
          </div>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>
