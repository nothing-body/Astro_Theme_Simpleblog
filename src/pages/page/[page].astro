---
import PostsPage from '../../components/PostsPage.astro';
import { getPostsPageStaticPaths } from '../../lib/posts';

export const getStaticPaths = () => getPostsPageStaticPaths('en');

const { totalPages, allPosts } = Astro.props;
const currentPage = Number(Astro.params.page);
---

<PostsPage lang="en" allPosts={allPosts} currentPage={currentPage} totalPages={totalPages} />
