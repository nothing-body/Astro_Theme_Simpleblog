# Copy this file to .env for local builds.
# Commit only this template. Keep the real .env private.

# Google Analytics 4 Measurement ID. Leave empty if analytics is not used.
PUBLIC_GA4_ID=

# Public production origin used by sitemap, canonical URLs, robots.txt, and structured data.
# Use https:// and do not include a trailing slash.
PUBLIC_SITE_URL=https://example.com
PUBLIC_SITE_NAME=Astro Simple Blog
PUBLIC_SITE_AUTHOR=Site Author
PUBLIC_SITE_DESCRIPTION=A multilingual Astro blog for notes, guides, and articles.

# Public contact email shown in contact/privacy pages.
PUBLIC_CONTACT_EMAIL=contact@example.com
