# 1) Copy this file to .env.vercel.
# 2) Fill in real Vercel deploy values.
# 3) Keep .env.vercel private (already ignored by .gitignore).

# Vercel Account Settings > Tokens
VERCEL_TOKEN=

# Required project ID. Find it in Project Settings > General.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optional. Defaults to the lowercase package.json name.
VERCEL_PROJECT_NAME=

PUBLIC_SITE_URL=https://example.com
PUBLIC_SITE_NAME=Astro Simple Blog
PUBLIC_SITE_AUTHOR=Site Author
PUBLIC_SITE_DESCRIPTION=A multilingual Astro blog for notes, guides, and articles.
PUBLIC_CONTACT_EMAIL=contact@example.com
